# Banco de dados (SQLite: arquivo local criado automaticamente pelas migrations)
DATABASE_URL="file:./dev.db"

# JWT — troque por um valor aleatório longo em qualquer ambiente real
JWT_SECRET="troque-por-um-valor-aleatorio-longo"
JWT_EXPIRES_IN_SECONDS=3600

# Porta HTTP da API
PORT=3000

# Limites de requisições por minuto/IP (proteção contra abuso e força bruta)
RATE_LIMIT_POR_MINUTO=300
LOGIN_LIMITE_POR_MINUTO=20
